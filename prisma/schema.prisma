generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STORE_MANAGER
  INVENTORY_MANAGER
  SUPPORT
  MARKETING
  CONTENT
  FINANCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String    @unique
  phoneVerified Boolean   @default(false)
  otpCode       String?
  otpExpires    DateTime?
  password      String?
  role          Role      @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  nameAr   String
  nameFr   String?
  parentId String?
  parent   Category?  @relation("CatChildren", fields: [parentId], references: [id])
  children Category[] @relation("CatChildren")
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  nameAr      String
  nameFr      String?
  description String
  brandId     String
  brand       Brand            @relation(fields: [brandId], references: [id])
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  nutrition   NutritionFacts?
  reviews     Review[]
  createdAt   DateTime         @default(now())

  @@index([categoryId, brandId])
}

model ProductVariant {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String           @unique
  barcode           String?
  flavor            String?
  weight            String
  price             Int
  compareAtPrice    Int?
  stock             Int              @default(0)
  lowStockThreshold Int              @default(5)
  expiryDate        DateTime
  batchNumber       String
  warehouse         String           @default("غرداية")
  ledger            InventoryLedger[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
}

model NutritionFacts {
  id           String  @id @default(cuid())
  productId    String  @unique
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  servingSize  String
  calories     Int
  protein      Float
  carbs        Float
  fat          Float
  sugar        Float?
  sodium       Float?
  ingredients  String
  allergens    String?
  warnings     String
}

model InventoryLedger {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  change    Int
  reason    String
  createdAt DateTime       @default(now())
}

model Order {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  subtotal        Int
  shippingCost    Int
  total           Int
  wilaya          String
  commune         String
  address         String
  phone           String
  shippingProvider String       @default("Nord Ouest")
  trackingNumber  String?
  idempotencyKey  String?       @unique
  items           OrderItem[]
  createdAt       DateTime      @default(now())

  @@index([status, wilaya])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  name      String
  price     Int
  qty       Int
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  wilaya    String
  commune   String
  street    String
  isDefault Boolean @default(false)
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
}
