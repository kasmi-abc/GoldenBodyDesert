# Database - Neon PostgreSQL
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Admin - /admin/login
ADMIN_USER="admin"
ADMIN_PASS_HASH="<bcrypt-hash>"
# generate: node -e "console.log(require('bcryptjs').hashSync('your-password',10))"
AUTH_SECRET="change-me-32chars-random-base64url"

# NextAuth (Auth.js)
NEXTAUTH_SECRET="change-this-to-32-random-chars"
NEXTAUTH_URL="http://localhost:3000"

# Redis (Upstash)
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_KEY="masterKey"

# Cloudinary / S3
CLOUDINARY_URL="cloudinary://..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OTP SMS Gateway (Algerian provider)
SMS_API_KEY=""
SMS_SENDER="GoldenBody"

# Nord Ouest API
NORDOUEST_API_KEY=""
NORDOUEST_API_URL="https://api.nordouest.com/v1"
# Legacy Yalidine (kept for compatibility)
YALIDINE_API_KEY=""
YALIDINE_API_URL="https://api.yalidine.com/v1"
